{
  "name": "Xconect • Tenant Payment Policy (Gateway-Managed Stripe)",
  "slug": "xconect-tenant-payment-policy-stripe-gateway",
  "description": "Tenant-owned gateway-managed Stripe payment guard xapp for xconect (gateway-hosted Stripe checkout).",
  "version": "1.0.215",
  "visibility": "private",
  "target_client_id": "__TENANT_CLIENT_ID__",
  "metadata": {
    "xconect": {
      "owner": "tenant",
      "workspace": "xconect"
    },
    "catalog": {
      "hidden": true
    }
  },
  "tags": ["xconect", "tenant", "guards", "payment", "policy", "gateway-managed", "stripe"],
  "tools": [
    {
      "tool_name": "evaluate_tenant_payment_policy",
      "title": "Evaluate Tenant Payment Policy",
      "description": "Returns payment guard decision with optional UI orchestration metadata for redirect-and-resume flows.",
      "input_schema": {
        "type": "object",
        "properties": {
          "payment_status": {
            "type": "string"
          },
          "guard": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "config": {
                "type": "object"
              }
            }
          },
          "context": {
            "type": "object",
            "properties": {
              "toolName": {
                "type": "string"
              },
              "orchestration": {
                "type": "object"
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        },
        "required": ["allowed"]
      }
    }
  ],
  "widgets": [
    {
      "widget_name": "xconect_tenant_payment_policy_stripe_gateway_guard",
      "title": "Xconect Tenant Payment Policy (Gateway-Managed Stripe)",
      "type": "read",
      "renderer": "platform",
      "bind_tool_name": "evaluate_tenant_payment_policy",
      "entry": {
        "kind": "platform_template",
        "template": "read_only_result"
      },
      "config": {
        "xapps": {
          "result_presentation": "inline"
        }
      }
    }
  ],
  "payment_guard_definitions": [
    {
      "name": "xconect_tenant_pay_by_request_gateway_stripe",
      "payment_type": "pay_by_request",
      "payment_issuer_mode": "gateway_managed",
      "payment_scheme": "stripe",
      "payment_allowed_issuers": ["gateway"],
      "payment_return_contract": "xapps_payment_orchestration_v1",
      "payment_return_required": true,
      "payment_return_max_age_s": 900,
      "payment_return_hmac_secret_refs": {
        "gateway": "platform://payment:gateway:hmac"
      },
      "payment_provider_credentials_refs": {
        "stripe": {
          "bundle_ref": "platform://payment:gateway:stripe:bundle"
        }
      },
      "payment_ui": {
        "brand": {
          "name": "Xconect Tenant",
          "accent": "#635bff"
        },
        "copy": {
          "title": "Xconect Tenant",
          "subtitle": "Gateway checkout"
        },
        "schemes": [
          {
            "scheme": "stripe",
            "badge": "Stripe",
            "title": "Pay with Stripe",
            "subtitle": "Secure card checkout hosted by Stripe.",
            "cta_label": "Continue to Stripe",
            "help_text": "Secure card checkout hosted by Stripe.",
            "accent": "#635bff"
          },
          {
            "scheme": "mock_manual",
            "badge": "Hosted Redirect",
            "title": "Hosted Checkout Test",
            "subtitle": "Provider-style redirect and signed return flow.",
            "cta_label": "Continue to Checkout",
            "help_text": "Hosted redirect flow for end-to-end payment return testing.",
            "accent": "#0f766e"
          }
        ]
      },
      "accepts": [
        {
          "scheme": "mock_manual",
          "label": "Mock Hosted Redirect"
        }
      ],
      "owner_override_allowlist": [
        "tool_name",
        "tools",
        "ui_mode",
        "allow_orchestration_approval",
        "pricing.default_amount",
        "pricing.xapp_prices.*",
        "pricing.tool_overrides.*",
        "policy",
        "action"
      ],
      "owner_pricing_floor": {
        "default_amount": 3,
        "xapp_prices": {
          "xplace-certs-gateway-stripe": 3,
          "xplace-weather-now-gateway-stripe": 3
        },
        "tool_overrides": {
          "xplace-certs-gateway-stripe:submit_certificate_request_async": 3.5
        }
      },
      "pricing_model": "pay_per_request",
      "receipt_field": "paymentReceipt",
      "payment_url": "__GATEWAY_BASE_URL__/v1/gateway-payment.html",
      "pricing": {
        "currency": "USD",
        "default_amount": 3,
        "description": "Xconect gateway-managed Stripe pay-per-request fee",
        "xapp_prices": {
          "xplace-certs-gateway-stripe": 3,
          "xplace-weather-now-gateway-stripe": 3
        },
        "tool_overrides": {
          "xplace-certs-gateway-stripe:submit_certificate_request_async": 3.5
        }
      },
      "policy": {
        "kind": "payment",
        "reason": "payment_required",
        "message": "Gateway-managed Stripe payment is required before continuing."
      },
      "action": {
        "kind": "complete_payment",
        "label": "Open Payment",
        "title": "Complete Payment",
        "target": "external"
      }
    }
  ],
  "guards": [],
  "endpoints": {
    "prod": {
      "base_url": "__XCONECT_TENANT_GUARD_BASE_URL__",
      "timeout_ms": 5000,
      "region": "tenant",
      "labels": {
        "profile": "xconect-tenant-guards",
        "env": "dev"
      }
    }
  },
  "connectivity": {
    "executor_mode": "PRIVATE_EXECUTOR",
    "auth_mode": "USER_DELEGATED",
    "signing_policy": "none",
    "proxy_policy": {
      "egress_enabled": false
    }
  }
}

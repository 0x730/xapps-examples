{
  "name": "Xconect • Tenant Payment Policy (Tenant-Managed)",
  "title": {
    "en": "Xconect • Tenant Payment Policy (Tenant-Managed)",
    "ro": "Xconect • Politică de plată tenant (gestionată de tenant)"
  },
  "slug": "xconect-tenant-payment-policy",
  "description": {
    "en": "Tenant-owned tenant-managed payment guard xapp for xconect pay-per-request policy orchestration.",
    "ro": "Xapp de gardă de plată deținut de tenant pentru orchestrarea politicii xconect pay-per-request în regim gestionat de tenant."
  },
  "version": "1.1.356",
  "visibility": "private",
  "target_client_id": "__TENANT_CLIENT_ID__",
  "metadata": {
    "xconect": {
      "owner": "tenant",
      "workspace": "xconect"
    },
    "catalog": {
      "hidden": true
    }
  },
  "tags": ["xconect", "tenant", "guards", "payment", "policy"],
  "tools": [
    {
      "tool_name": "evaluate_tenant_payment_policy",
      "title": {
        "en": "Evaluate Tenant Payment Policy",
        "ro": "Evaluează politica de plată a tenantului"
      },
      "description": {
        "en": "Returns payment guard decision with optional UI orchestration metadata for redirect-and-resume flows.",
        "ro": "Întoarce decizia gărzii de plată cu metadate opționale de orchestrare UI pentru fluxurile redirect-and-resume."
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "payment_status": {
            "type": "string"
          },
          "guard": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "config": {
                "type": "object"
              }
            }
          },
          "context": {
            "type": "object",
            "properties": {
              "toolName": {
                "type": "string"
              },
              "orchestration": {
                "type": "object"
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        },
        "required": ["allowed"]
      }
    }
  ],
  "widgets": [
    {
      "widget_name": "xconect_tenant_payment_policy_guard",
      "title": {
        "en": "Xconect Tenant Payment Policy (Tenant-Managed)",
        "ro": "Politică de plată Xconect tenant (gestionată de tenant)"
      },
      "type": "read",
      "renderer": "platform",
      "bind_tool_name": "evaluate_tenant_payment_policy",
      "entry": {
        "kind": "platform_template",
        "template": "read_only_result"
      },
      "config": {
        "xapps": {
          "result_presentation": "inline"
        }
      }
    }
  ],
  "payment_guard_definitions": [
    {
      "name": "xconect_tenant_pay_by_request",
      "payment_type": "pay_by_request",
      "payment_issuer_mode": "owner_managed",
      "payment_scheme": "mock_manual",
      "payment_allowed_issuers": ["tenant"],
      "payment_return_contract": "xapps_payment_orchestration_v1",
      "payment_return_required": true,
      "payment_return_max_age_s": 900,
      "payment_return_hmac_secret_refs": {
        "tenant": "__TENANT_PAYMENT_RETURN_SECRET_REF__"
      },
      "owner_override_allowlist": [
        "tool_name",
        "tools",
        "ui_mode",
        "allow_orchestration_approval",
        "pricing.default_amount",
        "pricing.tool_overrides.*",
        "policy",
        "action"
      ],
      "owner_pricing_floor": {
        "default_amount": 3
      },
      "receipt_field": "paymentReceipt",
      "payment_url": "__XCONECT_TENANT_PAYMENT_BASE_URL__/tenant-payment.html",
      "pricing": {
        "currency": "USD",
        "default_amount": 3,
        "description": "Xconect tenant-managed pay-per-request fee"
      },
      "policy": {
        "kind": "payment",
        "reason": "payment_required",
        "message": "Tenant-managed payment is required before continuing."
      },
      "action": {
        "kind": "complete_payment",
        "label": {
          "en": "Open Payment",
          "ro": "Deschide plata"
        },
        "title": {
          "en": "Complete Payment",
          "ro": "Finalizează plata"
        },
        "target": "external"
      }
    }
  ],
  "guards": [],
  "endpoints": {
    "prod": {
      "base_url": "__XCONECT_TENANT_GUARD_BASE_URL__",
      "timeout_ms": 5000,
      "region": "tenant",
      "labels": {
        "profile": "xconect-tenant-guards",
        "env": "dev"
      }
    }
  },
  "connectivity": {
    "executor_mode": "PRIVATE_EXECUTOR",
    "auth_mode": "USER_DELEGATED",
    "signing_policy": "none",
    "proxy_policy": {
      "egress_enabled": false
    }
  }
}

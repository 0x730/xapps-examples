{
  "name": "Xconect • Tenant Payment Policy (Tenant-Delegated Stripe)",
  "title": {
    "en": "Xconect • Tenant Payment Policy (Tenant-Delegated Stripe)",
    "ro": "Xconect • Politică de plată tenant (Stripe delegat tenantului)"
  },
  "slug": "xconect-tenant-payment-policy-stripe-delegated",
  "description": {
    "en": "Tenant-owned tenant-delegated Stripe payment guard xapp for xconect (gateway-hosted Stripe checkout with tenant-scoped credentials).",
    "ro": "Xapp de gardă de plată Stripe delegat tenantului, deținut de tenant, pentru xconect (checkout Stripe găzduit de gateway cu credențiale specifice tenantului)."
  },
  "version": "1.0.177",
  "visibility": "private",
  "target_client_id": "__TENANT_CLIENT_ID__",
  "metadata": {
    "xconect": {
      "owner": "tenant",
      "workspace": "xconect"
    },
    "catalog": {
      "hidden": true
    }
  },
  "tags": ["xconect", "tenant", "guards", "payment", "policy", "tenant-delegated", "stripe"],
  "tools": [
    {
      "tool_name": "evaluate_tenant_payment_policy",
      "title": {
        "en": "Evaluate Tenant Payment Policy",
        "ro": "Evaluează politica de plată a tenantului"
      },
      "description": {
        "en": "Returns payment guard decision with optional UI orchestration metadata for redirect-and-resume flows.",
        "ro": "Întoarce decizia gărzii de plată cu metadate opționale de orchestrare UI pentru fluxurile redirect-and-resume."
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "payment_status": {
            "type": "string"
          },
          "guard": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "config": {
                "type": "object"
              }
            }
          },
          "context": {
            "type": "object",
            "properties": {
              "toolName": {
                "type": "string"
              },
              "orchestration": {
                "type": "object"
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        },
        "required": ["allowed"]
      }
    }
  ],
  "widgets": [
    {
      "widget_name": "xconect_tenant_payment_policy_stripe_delegated_guard",
      "title": {
        "en": "Xconect Tenant Payment Policy (Tenant-Delegated Stripe)",
        "ro": "Politică de plată Xconect tenant (Stripe delegat tenantului)"
      },
      "type": "read",
      "renderer": "platform",
      "bind_tool_name": "evaluate_tenant_payment_policy",
      "entry": {
        "kind": "platform_template",
        "template": "read_only_result"
      },
      "config": {
        "xapps": {
          "result_presentation": "inline"
        }
      }
    }
  ],
  "payment_guard_definitions": [
    {
      "name": "xconect_tenant_pay_by_request_delegated_stripe",
      "payment_type": "pay_by_request",
      "payment_issuer_mode": "tenant_delegated",
      "payment_scheme": "stripe",
      "payment_allowed_issuers": ["tenant_delegated"],
      "payment_return_contract": "xapps_payment_orchestration_v1",
      "payment_return_required": true,
      "payment_return_max_age_s": 900,
      "payment_return_hmac_delegated_secret_refs": {
        "tenant_delegated": {
          "__TENANT_CLIENT_ID__": "__TENANT_PAYMENT_RETURN_SECRET_REF__"
        }
      },
      "payment_provider_credentials_refs": {
        "stripe": {
          "bundle_ref": "platform://payment:tenant:stripe:bundle?scope=client&scope_id=__TENANT_CLIENT_ID__"
        }
      },
      "payment_ui": {
        "brand": {
          "name": {
            "en": "Xconect Tenant",
            "ro": "Tenant Xconect"
          },
          "accent": "#635bff"
        },
        "copy": {
          "title": {
            "en": "Xconect Tenant",
            "ro": "Tenant Xconect"
          },
          "subtitle": {
            "en": "Tenant-delegated Stripe checkout",
            "ro": "Checkout Stripe delegat tenantului"
          }
        },
        "schemes": [
          {
            "scheme": "stripe",
            "badge": {
              "en": "Stripe",
              "ro": "Stripe"
            },
            "title": {
              "en": "Pay with Stripe",
              "ro": "Plătește cu Stripe"
            },
            "subtitle": {
              "en": "Secure card checkout hosted by Stripe with tenant-scoped delegated credentials.",
              "ro": "Checkout securizat cu cardul, găzduit de Stripe, cu credențiale delegate specifice tenantului."
            },
            "cta_label": {
              "en": "Continue to Stripe",
              "ro": "Continuă către Stripe"
            },
            "help_text": {
              "en": "Secure card checkout hosted by Stripe on the tenant delegated lane.",
              "ro": "Checkout securizat cu cardul, găzduit de Stripe, pe fluxul delegat tenantului."
            },
            "accent": "#635bff"
          },
          {
            "scheme": "mock_manual",
            "badge": {
              "en": "Hosted Redirect",
              "ro": "Redirect găzduit"
            },
            "title": {
              "en": "Hosted Checkout Test",
              "ro": "Test checkout găzduit"
            },
            "subtitle": {
              "en": "Provider-style redirect and signed return flow.",
              "ro": "Flux de redirect și retur semnat, în stil provider."
            },
            "cta_label": {
              "en": "Continue to Checkout",
              "ro": "Continuă către checkout"
            },
            "help_text": {
              "en": "Hosted redirect flow for end-to-end payment return testing.",
              "ro": "Flux de redirect găzduit pentru testarea end-to-end a revenirii din plată."
            },
            "accent": "#0f766e"
          }
        ]
      },
      "accepts": [
        {
          "scheme": "mock_manual",
          "label": "Mock Hosted Redirect"
        }
      ],
      "owner_override_allowlist": [
        "tool_name",
        "tools",
        "ui_mode",
        "allow_orchestration_approval",
        "pricing.default_amount",
        "pricing.xapp_prices.*",
        "pricing.tool_overrides.*",
        "policy",
        "action"
      ],
      "owner_pricing_floor": {
        "default_amount": 3,
        "xapp_prices": {
          "xplace-certs-tenant-delegated-stripe": 3
        },
        "tool_overrides": {
          "xplace-certs-tenant-delegated-stripe:submit_certificate_request_async": 3.5
        }
      },
      "pricing_model": "pay_per_request",
      "receipt_field": "paymentReceipt",
      "payment_url": "__GATEWAY_BASE_URL__/v1/gateway-payment.html",
      "pricing": {
        "currency": "USD",
        "default_amount": 3,
        "description": "Xconect tenant-delegated Stripe pay-per-request fee",
        "xapp_prices": {
          "xplace-certs-tenant-delegated-stripe": 3
        },
        "tool_overrides": {
          "xplace-certs-tenant-delegated-stripe:submit_certificate_request_async": 3.5
        }
      },
      "policy": {
        "kind": "payment",
        "reason": "payment_required",
        "message": "Tenant-delegated Stripe payment is required before continuing."
      },
      "action": {
        "kind": "complete_payment",
        "label": "Open Payment",
        "title": "Complete Payment",
        "target": "external"
      }
    }
  ],
  "guards": [],
  "endpoints": {
    "prod": {
      "base_url": "__XCONECT_TENANT_GUARD_BASE_URL__",
      "timeout_ms": 5000,
      "region": "tenant",
      "labels": {
        "profile": "xconect-tenant-guards",
        "env": "dev"
      }
    }
  },
  "connectivity": {
    "executor_mode": "PRIVATE_EXECUTOR",
    "auth_mode": "USER_DELEGATED",
    "signing_policy": "none",
    "proxy_policy": {
      "egress_enabled": false
    }
  }
}

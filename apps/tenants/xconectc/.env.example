APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# XconectC tenant integration (kit-backed host API + bridge-v2)
XAPPS_GATEWAY_URL=http://localhost:3000
XAPPS_API_KEY=
XCONECTC_GUARD_INGEST_API_KEY=xconectc-tenant-guard-dev-key
IDP_BASE_URL=http://localhost:8001/api
XCONECTC_HOST_PUBLIC_BASE_URL=http://localhost:8002
XCONECTC_HOST_BACKEND_BASE_URL=http://localhost:8001
XCONECTC_ALLOWED_ORIGINS=http://localhost:8001,http://localhost:8002,http://localhost:5177,http://127.0.0.1:8001,http://127.0.0.1:8002,http://127.0.0.1:5177
XCONECTC_HOST_BOOTSTRAP_API_KEYS=
XCONECTC_HOST_BOOTSTRAP_SIGNING_SECRET=
XCONECTC_HOST_BOOTSTRAP_SIGNING_KEY_ID=bootstrap-current
XCONECTC_HOST_BOOTSTRAP_VERIFIER_KEYS_JSON=
XCONECTC_HOST_SESSION_SIGNING_SECRET=
XCONECTC_HOST_SESSION_SIGNING_KEY_ID=session-current
XCONECTC_HOST_SESSION_VERIFIER_KEYS_JSON=
XCONECTC_TENANT_PAYMENT_URL=http://localhost:8001/tenant-payment.html
XCONECTC_TENANT_PAYMENT_RETURN_SECRET=
XCONECTC_TENANT_PAYMENT_RETURN_SECRET_REF=
XCONECTC_TENANT_PAYMENT_RETURN_URL_ALLOWLIST=http://localhost:8001,http://localhost:8002,http://127.0.0.1:8001,http://127.0.0.1:8002

  ],
  "endpoints": {
    "prod": {
      "base_url": "__XPLACE_BACKEND_BASE_URL__/xapps/requests",
      "timeout_ms": 12000,
      "retry_policy": {
        "max_retries": 1,
        "backoff": "exponential"
      },
      "labels": {
        "profile": "xplace-certs-xms-jsonforms-vc",
        "env": "dev"
      }
    }
  }

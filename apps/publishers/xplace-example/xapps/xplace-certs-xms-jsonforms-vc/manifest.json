  "tools": [
    {
      "tool_name": "submit_xms_certificate_request_vc",
      "title": {
        "en": "Submit XMS Certificate Request VC",
        "ro": "Trimite cerere certificat XMS VC"
      },
      "description": {
        "en": "Submits a certificate request and enforces XMS virtual-currency access for the active subject.",
        "ro": "Trimite o cerere de certificat și aplică accesul XMS cu monedă virtuală pentru subiectul activ."
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "companyCui": {
            "type": "string",
            "title": "CUI Firmă",
            "description": "Introduceți CUI-ul firmei pentru verificare automată ANAF (ex: RO12345678).",
            "pattern": "^(RO)?[0-9]{2,13}$"
          },
          "requestPurpose": {
            "type": "string",
            "title": "Motiv solicitare",
            "oneOf": [
              {
                "const": "licitatie",
                "title": "Licitație"
              },
              {
                "const": "dosar",
                "title": "Dosar"
              },
              {
                "const": "contractare",
                "title": "Contractare"
              },
              {
                "const": "conformitate",
                "title": "Conformitate"
              }
            ]
          },
          "requestDetails": {
            "type": "string",
            "title": "Detalii solicitare"
          }
        },
        "required": ["companyCui", "requestPurpose"]
      },
      "input_ui_schema": {
        "type": "Categorization",
        "options": {
          "variant": "stepper"
        },
        "elements": [
          {
            "type": "Category",
            "label": "Companie",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/companyCui"
              },
              {
                "type": "XAppsDisplayPanel",
                "component": "data-view",
                "label": "Date companie verificate",
                "options": {
                  "dataSource": {
                    "kind": "publisher_preview",
                    "endpointKey": "anaf_company_lookup_preview",
                    "inputMapping": {
                      "companyCui": "#/properties/companyCui"
                    },
                    "debounceMs": 250,
                    "cacheTtlMs": 2000
                  },
                  "view": {
                    "type": "key-value",
                    "fields": [
                      {
                        "path": "#/status",
                        "label": "Status"
                      },
                      {
                        "path": "#/companyName",
                        "label": "Denumire"
                      },
                      {
                        "path": "#/companyCui",
                        "label": "CUI"
                      }
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "Category",
            "label": "Solicitare",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/requestPurpose"
              },
              {
                "type": "Control",
                "scope": "#/properties/requestDetails",
                "options": {
                  "multi": true
                }
              }
            ]
          }
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "status": {
            "type": "string"
          },
          "entitlement_state": {
            "type": ["string", "null"]
          },
          "has_current_access": {
            "type": "boolean"
          },
          "access_summary": {
            "type": "string"
          },
          "companyCui": {
            "type": "string"
          },
          "credit_cost": {
            "type": ["number", "null"]
          },
          "credits_remaining": {
            "type": ["string", "null"]
          },
          "subscriptionStatus": {
            "type": ["string", "null"]
          },
          "virtualCurrencyCode": {
            "type": ["string", "null"]
          },
          "virtualCurrencyName": {
            "type": ["string", "null"]
          },
          "requestRef": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "has_current_access",
          "access_summary",
          "companyCui",
          "requestRef",
          "summary"
        ]
      },
      "output_ui_schema": {
        "xapps": {
          "manual_response": true,
          "renderer": "json-forms",
          "render": {
            "kind": "kv",
            "title": "XMS Certificate VC Result",
            "fields": [
              {
                "label": "Status",
                "path": "status"
              },
              {
                "label": "Entitlement State",
                "path": "entitlement_state"
              },
              {
                "label": "Has Current Access",
                "path": "has_current_access"
              },
              {
                "label": "Access Summary",
                "path": "access_summary"
              },
              {
                "label": "Company CUI",
                "path": "companyCui"
              },
              {
                "label": "Credits Used",
                "path": "credit_cost"
              },
              {
                "label": "Credits Remaining",
                "path": "credits_remaining"
              },
              {
                "label": "Virtual Currency Code",
                "path": "virtualCurrencyCode"
              },
              {
                "label": "Virtual Currency Name",
                "path": "virtualCurrencyName"
              },
              {
                "label": "Subscription Status",
                "path": "subscriptionStatus"
              },
              {
                "label": "Request Ref",
                "path": "requestRef"
              },
              {
                "label": "Summary",
                "path": "summary"
              }
            ]
          }
        },
        "type": "VerticalLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/status"
          },
          {
            "type": "Control",
            "scope": "#/properties/entitlement_state"
          },
          {
            "type": "Control",
            "scope": "#/properties/has_current_access"
          },
          {
            "type": "Control",
            "scope": "#/properties/access_summary"
          },
          {
            "type": "Control",
            "scope": "#/properties/companyCui"
          },
          {
            "type": "Control",
            "scope": "#/properties/credits_remaining"
          },
          {
            "type": "Control",
            "scope": "#/properties/virtualCurrencyCode"
          },
          {
            "type": "Control",
            "scope": "#/properties/virtualCurrencyName"
          },
          {
            "type": "Control",
            "scope": "#/properties/subscriptionStatus"
          },
          {
            "type": "Control",
            "scope": "#/properties/requestRef"
          },
          {
            "type": "Control",
            "scope": "#/properties/summary",
            "options": {
              "multi": true
            }
          }
        ]
      }
    }
  ],
  "widgets": [

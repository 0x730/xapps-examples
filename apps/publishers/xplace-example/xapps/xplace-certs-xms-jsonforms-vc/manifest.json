    {
      "slug": "platform-internal-notification-handler",
      "trigger": "after:response_finalized",
      "headless": true,
      "config": {
        "notification_ref": "gateway_response_finalized_email"
      }
    }
  ],
  "guards_policy": {
    "before:tool_run": "all",
    "after:payment_completed": "all",
    "after:response_finalized": "all"
  },
  "connectivity": {

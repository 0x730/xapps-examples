          },
          "title": {
            "en": "XMS access required",
            "ro": "Este necesar acces XMS"
          },
          "intent": "xms_access"
        }
      }
    },
    {
      "slug": "platform-internal-invoice-handler",
      "trigger": "after:payment_completed",
      "headless": true,
      "config": {
        "invoice_ref": "gateway_payment_invoice"

  "guards": [
    {
      "slug": "xconect-tenant-subject-profile-policy",
      "trigger": "before:session_open",
      "headless": false,
      "config": {
        "subject_profile_guard_ref": "xconect_tenant_billing_business",
        "subject_profile_sources": {
          "publisher": {
            "provider_kind": "endpoint",
            "endpoint_base_url": "__XPLACE_BACKEND_BASE_URL__/guard/subject-profiles/publisher-candidates",
            "tool_payload": {
              "xapp_slug": "xplace-creator-club-publisher-rendered",
              "widget_name": "creator_club_publisher_rendered_widget"
            }
          }
        }
      }
    }
  ],
  "guards_policy": {
    "before:session_open": "all"
  },
  "connectivity": {
    "executor_mode": "PUBLIC_EXECUTOR",
    "auth_mode": "PUBLISHER_APP",
    "signing_policy": "none",
    "webhooks": {
      "enabled": true
    },
    "proxy_policy": {
      "egress_enabled": false
    }
  },
  "event_subscriptions": [
    {
      "event_type": "xapps.request.completed",
      "webhook_url": "__XPLACE_BACKEND_BASE_URL__/webhooks/events"
    },
    {
      "event_type": "xapps.request.failed",
      "webhook_url": "__XPLACE_BACKEND_BASE_URL__/webhooks/events"
    },
    {
      "event_type": "xapps.xms.purchase_intent.prepared",
      "webhook_url": "__XPLACE_BACKEND_BASE_URL__/webhooks/events"
    },
    {
      "event_type": "xapps.xms.transaction.reconciled",
      "webhook_url": "__XPLACE_BACKEND_BASE_URL__/webhooks/events"
    },
    {
      "event_type": "xapps.xms.access.issued",
      "webhook_url": "__XPLACE_BACKEND_BASE_URL__/webhooks/events"
    },
    {
      "event_type": "xapps.xms.access_snapshot.refreshed",
      "webhook_url": "__XPLACE_BACKEND_BASE_URL__/webhooks/events"
    }
  ],
  "endpoints": {
    "prod": {

  "metadata": {
    "creator_club": {
      "features": [
        {
          "key": "premium_template_vault",
          "title": {
            "en": "Premium Template Vault",
            "ro": "Vault de template-uri premium"
          },
          "description": {
            "en": "Durable unlock style feature that should open once current access is available.",
            "ro": "Funcție de tip deblocare durabilă care ar trebui să se deschidă când accesul curent este disponibil."
          },
          "requirements": {
            "currentAccess": true
          }
        },
        {
          "key": "team_workspace_digest",
          "title": {
            "en": "Team Workspace Digest",
            "ro": "Digest pentru workspace-ul echipei"
          },
          "description": {
            "en": "Subscription-oriented feature for recurring workspace summaries.",
            "ro": "Funcție orientată pe abonament pentru rezumate recurente de workspace."
          },
          "requirements": {
            "subscription": true
          }
        },
        {
          "key": "credit_burst_export",
          "title": {
            "en": "Credit Burst Export",
            "ro": "Export burst pe credite"
          },
          "description": {
            "en": "Wallet-style feature that expects available credits for each advanced export.",
            "ro": "Funcție de tip portofel care cere credite disponibile pentru fiecare export avansat."
          },
          "requirements": {
            "credits": 100
          }
        },
        {
          "key": "hybrid_campaign_batch",
          "title": {
            "en": "Hybrid Campaign Batch",
            "ro": "Lot hibrid de campanii"
          },
          "description": {
            "en": "Combined feature that expects access coverage and a meaningful credit balance.",
            "ro": "Funcție combinată care cere acoperire de acces și un sold relevant de credite."
          },
          "requirements": {
            "currentAccess": true,
            "credits": 250
          }
        }
      ]
    }
  },

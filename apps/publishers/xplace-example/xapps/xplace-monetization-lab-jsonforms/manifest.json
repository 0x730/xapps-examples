  "tools": [
    {
      "tool_name": "open_monetization_lab",
      "title": {
        "en": "Open Monetization Lab",
        "ro": "Deschide laboratorul de monetizare"
      },
      "description": {
        "en": "Reference tool for exercising the monetization catalog and scope choices in xplace-example.",
        "ro": "Tool de referință pentru exercitarea catalogului de monetizare și a alegerilor de scope în xplace-example."
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "scopeKind": {
            "type": "string",
            "title": "Activation Scope",
            "enum": [
              "subject",
              "installation",
              "realm"
            ],
            "default": "subject"
          },
          "realmRef": {
            "type": "string",
            "title": "Workspace / Realm Ref",
            "description": "Optional workspace identifier when testing realm-scoped subscriptions or hybrid plans."
          },
          "requestedPackage": {
            "type": "string",
            "title": "Requested Package",
            "oneOf": [
              {
                "const": "starter_unlock",
                "title": "Starter Unlock"
              },
              {
                "const": "pro_monthly",
                "title": "Pro Monthly"
              },
              {
                "const": "credits_500",
                "title": "Credits 500"
              },
              {
                "const": "team_hybrid",
                "title": "Team Hybrid"
              }
            ],
            "default": "pro_monthly"
          },
          "contactEmail": {
            "type": "string",
            "format": "email",
            "title": "Contact Email"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          }
        }
      },
      "input_ui_schema": {
        "type": "Categorization",
        "options": {
          "variant": "stepper"
        },
        "elements": [
          {
            "type": "Category",
            "label": "Scope",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/scopeKind"
              },
              {
                "type": "Control",
                "scope": "#/properties/realmRef"
              }
            ]
          },
          {
            "type": "Category",
            "label": "Package",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/requestedPackage"
              }
            ]
          },
          {
            "type": "Category",
            "label": "Contact",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/contactEmail"
              },
              {
                "type": "Control",
                "scope": "#/properties/notes",
                "options": {
                  "multi": true
                }
              }
            ]
          }
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "status": {
            "type": "string"
          },
          "activationScope": {
            "type": "string"
          },
          "requestedPackage": {
            "type": [
              "string",
              "null"
            ]
          },
          "requestedPackageLabel": {
            "type": "string"
          },
          "realmRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "contactEmail": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "activationScope",
          "requestedPackageLabel",
          "summary",
          "checkedAt"
        ]
      },
      "output_ui_schema": {
        "xapps": {
          "render": {
            "kind": "kv",
            "title": "Monetization Lab Result",
            "fields": [
              {
                "label": "Status",
                "path": "status"
              },
              {
                "label": "Activation Scope",
                "path": "activationScope"
              },
              {
                "label": "Requested Package",
                "path": "requestedPackageLabel"
              },
              {
                "label": "Workspace / Realm",
                "path": "realmRef"
              },
              {
                "label": "Contact Email",
                "path": "contactEmail"
              },
              {
                "label": "Notes",
                "path": "notes"
              },
              {
                "label": "Summary",
                "path": "summary"
              },
              {
                "label": "Checked At",
                "path": "checkedAt"
              }
            ]
          }
        },
        "type": "VerticalLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/status"
          },
          {
            "type": "Control",
            "scope": "#/properties/activationScope"
          },
          {
            "type": "Control",
            "scope": "#/properties/requestedPackageLabel"
          },
          {
            "type": "Control",
            "scope": "#/properties/realmRef"
          },
          {
            "type": "Control",
            "scope": "#/properties/contactEmail"
          },
          {
            "type": "Control",
            "scope": "#/properties/notes",
            "options": {
              "multi": true
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/summary",
            "options": {
              "multi": true
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/checkedAt"
          }
        ]
      }
    }
  ],
  "widgets": [
    {
      "widget_name": "xplace_monetization_lab_form",
      "title": {
        "en": "Monetization Lab",
        "ro": "Laborator de monetizare"
      },
      "type": "write",
      "renderer": "json-forms",
      "bind_tool_name": "open_monetization_lab",
      "entry": {
        "kind": "platform_template",
        "template": "write_form"
      },
      "config": {
        "xapps": {
          "result_presentation": "runtime_default"
        }
      }
    }
  ],
  "connectivity": {
    "executor_mode": "PUBLIC_EXECUTOR",
    "auth_mode": "PUBLISHER_APP",
    "signing_policy": "none",
    "webhooks": {
      "enabled": true
    },
    "proxy_policy": {
      "egress_enabled": false
    }
  },
  "event_subscriptions": [
    {
      "event_type": "xapps.request.completed",
      "webhook_url": "__XPLACE_BACKEND_BASE_URL__/webhooks/events"
    },
    {
      "event_type": "xapps.request.failed",
      "webhook_url": "__XPLACE_BACKEND_BASE_URL__/webhooks/events"
    }
  ],
  "endpoints": {
    "prod": {
      "base_url": "__XPLACE_BACKEND_BASE_URL__/xapps/requests",
      "timeout_ms": 10000,
      "retry_policy": {
        "max_retries": 1,
        "backoff": "linear"
      },
      "region": "global",
      "labels": {
        "publisher": "xplace-example-monetization",
        "env": "development"
      }
    }
  }
}

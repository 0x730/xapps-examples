XPLACE_EXAMPLE_PORT=3016
XPLACE_EXAMPLE_DATABASE_URL=postgresql:///xplace_example?host=/var/run/postgresql
# Publisher API key used by xplace-example tooling/backend when calling gateway publisher APIs
XPLACE_EXAMPLE_API_KEY=xplace-example-dev-api-key
XPLACE_EXAMPLE_GATEWAY_PUBLISHER_API_KEY=xplace-example-dev-api-key
# API key expected by xplace-example ingest endpoint (`x-xplace-api-key`) for xapp dispatch requests from gateway
XPLACE_EXAMPLE_XAPP_INGEST_API_KEY=xplace-example-dev-api-key
XPLACE_EXAMPLE_ADMIN_KEY=xplace-example-dev-admin-key
XPLACE_EXAMPLE_PUBLIC_BASE_URL=http://localhost:3016
GATEWAY_BASE_URL=http://localhost:3000
# Target client API key used by XMS-backed example tools when calling gateway client-scoped
# monetization routes. Keep this if you only exercise one reference tenant lane.
XPLACE_EXAMPLE_TARGET_CLIENT_API_KEY=
# Optional JSON map keyed by stable tenant/client slugs for multi-tenant example lanes.
# Example:
# XPLACE_EXAMPLE_TARGET_CLIENT_API_KEY_SLUG_MAP={"xconecta":"xconecta-dev-api-key","xconectb":"xconectb-dev-api-key","xconectc":"xapps_test_xconectc_key_123456789"}
XPLACE_EXAMPLE_TARGET_CLIENT_API_KEY_SLUG_MAP=
# Optional JSON map for additional target client ids when the example publisher is used against
# multiple seeded reference tenants. Prefer the slug map above for clean-db deploys.
# Example:
# XPLACE_EXAMPLE_TARGET_CLIENT_API_KEY_MAP={"01KN717MGDKA65M2NVV3Q8C64N":"xconectb-dev-api-key","01KN717RDJ613CSCR4008CT7H4":"xapps_test_xconectc_key_123456789"}
XPLACE_EXAMPLE_TARGET_CLIENT_API_KEY_MAP=
# Optional: override the public portal/publisher URLs used by creator-club workspace links.
# XPLACE_EXAMPLE_PORTAL_BASE_URL=http://localhost:5177/apps/portal
# XPLACE_EXAMPLE_PUBLISHER_BASE_URL=http://localhost:5176/apps/publisher
# Optional: timeout in ms for the startup publisher client-id -> slug lookup used only to
# support slug-keyed target client API key maps. Keep low so local boot does not stall when
# gateway is unavailable.
# XPLACE_EXAMPLE_PUBLISHER_CLIENT_LOOKUP_TIMEOUT_MS=3000
# Required for the publisher bridge-session reference lane. Use the provisioned publisher id.
# XPLACE_EXAMPLE_PUBLISHER_ID=01H...
# Required on both gateway and xplace-example when using the bridge-session reference lane.
# VENDOR_ASSERTION_SHARED_SECRET=bridge-shared-secret-dev
# Optional: override publisher-local bridge session TTL in seconds (default 3600).
# XPLACE_EXAMPLE_BRIDGE_SESSION_TTL_SECONDS=3600
# Optional: explicit iframe host/bootstrap origin allowlist for publisher-rendered widgets.
# Leave unset to preserve the current open bootstrap baseline for local/reference use.
# XPLACE_EXAMPLE_WIDGET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3314

# Optional: override public weather provider base URL (default is Open-Meteo)
# XPLACE_EXAMPLE_WEATHER_API_BASE_URL=https://api.open-meteo.com
# XPLACE_EXAMPLE_ANAF_API_BASE_URL=https://webservicesp.anaf.ro

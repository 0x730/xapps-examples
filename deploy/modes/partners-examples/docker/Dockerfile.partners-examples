FROM node:22 AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/backend-kit/package.json ./packages/backend-kit/package.json
COPY packages/browser-host/package.json ./packages/browser-host/package.json
COPY packages/marketplace-ui/package.json ./packages/marketplace-ui/package.json
COPY packages/openapi-import/package.json ./packages/openapi-import/package.json
COPY packages/payment-hosted-client/package.json ./packages/payment-hosted-client/package.json
COPY packages/payment-providers/package.json ./packages/payment-providers/package.json
COPY packages/publisher-verifier/package.json ./packages/publisher-verifier/package.json
COPY packages/server-sdk/package.json ./packages/server-sdk/package.json
COPY packages/signing-client/package.json ./packages/signing-client/package.json
COPY packages/widget-runtime/package.json ./packages/widget-runtime/package.json
COPY packages/widget-sdk/package.json ./packages/widget-sdk/package.json
COPY packages/xapps-cli/package.json ./packages/xapps-cli/package.json
COPY packages/xapps-embed-sdk/package.json ./packages/xapps-embed-sdk/package.json
COPY apps/core/docs/package.json ./apps/core/docs/package.json
COPY apps/core/payment-hosted/package.json ./apps/core/payment-hosted/package.json
COPY apps/core/portal/package.json ./apps/core/portal/package.json
COPY apps/core/publisher/package.json ./apps/core/publisher/package.json
COPY apps/core/superadmin/package.json ./apps/core/superadmin/package.json
COPY samples/package.json ./samples/package.json

ARG NPM_INSTALL_MODE=ci

RUN node -e "const fs=require('fs'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); pkg.workspaces=['packages/*']; fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2) + '\\n');"

RUN --mount=type=cache,target=/root/.npm \
  export NODE_ENV=development \
  && export NPM_CONFIG_FETCH_RETRIES=5 \
  && export NPM_CONFIG_FETCH_RETRY_FACTOR=2 \
  && export NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
  && export NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
  && if [ "${NPM_INSTALL_MODE}" = "ci" ]; then npm ci; else npm install --no-audit --no-fund; fi

COPY . .

RUN export NODE_ENV=development \
  && node scripts/build/build-embed-sdk.mjs \
  && node scripts/build/build-server-sdk.mjs \
  && node scripts/build/build-browser-host.mjs \
  && node scripts/build/build-backend-kit.mjs \
  && ASSEMBLE_RUNTIME_SKIP_NODE_MODULES=1 node deploy/scripts/assemble-runtime-tree.mjs partners-examples .runtime-image/partners-examples/app

FROM node:22 AS runtime

WORKDIR /app

COPY --from=builder /app/.runtime-image/partners-examples/app/ ./
COPY --from=builder /app/node_modules ./node_modules

ENV NODE_ENV=production

EXPOSE 3312 3412 3413 3016 8001 8002

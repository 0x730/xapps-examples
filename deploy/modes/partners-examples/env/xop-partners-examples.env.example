# XOP partners examples lane
# Broader public starter/reference lane deployed on the second server.
#
# Replace every sample/dev key and secret before real use, including `xapps_test_*`.
# Replace `db.internal` with the PostgreSQL host reachable from the example server.
# These hostnames are only suggestions; change them if the example server uses different public domains.

XAPPS_RUNTIME_IMAGE=xapps-runtime-partners-examples:local
XAPPS_RUNTIME_PHP_IMAGE=xapps-runtime-partners-examples-php:local
NPM_INSTALL_MODE=ci

XOP_PARTNERS_BIND_IP=127.0.0.1
ENABLE_XPLACE_EXAMPLE=1

XCONECTA_PORT=3314
ENABLE_XCONECTA_HOST=1
XCONECTA_HOST_PORT=3414
ENABLE_XCONECTB=1
ENABLE_XCONECTB_HOST=1
XCONECTB_PORT=3313
XCONECTB_HOST_PORT=3413
ENABLE_XCONECTC=1
ENABLE_XCONECTC_HOST=1
XCONECTC_PORT=8001
XCONECTC_HOST_PORT=8002
XPLACE_EXAMPLE_PORT=3016

INTERNAL_GATEWAY_BASE_URL=https://gateway.0x730.com

XCONECTA_NODE_ENV=production
XCONECTA_GATEWAY_API_KEY=xconecta-dev-api-key
XCONECTA_TENANT_API_KEY=xconecta-dev-api-key
XCONECTA_GUARD_INGEST_API_KEY=xconecta-tenant-guard-dev-key
XCONECTA_PUBLIC_BASE_URL=https://xconecta-example.0x730.com
XCONECTA_ALLOWED_ORIGINS=https://xconecta-example.0x730.com,https://xconecta-example-host.0x730.com,https://gateway.0x730.com
XCONECTA_HOST_BOOTSTRAP_API_KEYS=xconecta-dev-api-key
XCONECTA_HOST_BOOTSTRAP_SIGNING_SECRET=dev-xconecta-host-bootstrap-secret
XCONECTA_HOST_BOOTSTRAP_SIGNING_KEY_ID=bootstrap-current
XCONECTA_HOST_BOOTSTRAP_VERIFIER_KEYS_JSON={"bootstrap-current":"dev-xconecta-host-bootstrap-secret"}
XCONECTA_HOST_SESSION_SIGNING_SECRET=dev-xconecta-host-session-secret
XCONECTA_HOST_SESSION_SIGNING_KEY_ID=session-current
XCONECTA_HOST_SESSION_VERIFIER_KEYS_JSON={"session-current":"dev-xconecta-host-session-secret"}
XCONECTA_HOST_PUBLIC_BASE_URL=https://xconecta-example-host.0x730.com
XCONECTA_HOST_BACKEND_BASE_URL=https://xconecta-example.0x730.com
XCONECTA_HOST_BOOTSTRAP_BACKEND_BASE_URL=http://xconecta:3314
XCONECTA_HOST_BOOTSTRAP_API_KEY=xconecta-dev-api-key
XCONECTA_TENANT_PAYMENT_URL=https://xconecta-example.0x730.com/tenant-payment.html
XCONECTA_TENANT_PAYMENT_RETURN_SECRET=dev-tenant-a-payment-return-secret
XCONECTA_TENANT_PAYMENT_RETURN_SECRET_REF=
XCONECTA_TENANT_PAYMENT_RETURN_URL_ALLOWLIST=https://xconecta-example.0x730.com,https://xconecta-example-host.0x730.com,https://gateway.0x730.com

XCONECTB_GATEWAY_API_KEY=xconectb-dev-api-key
XCONECTB_TENANT_API_KEY=xconectb-dev-api-key
XCONECTB_GUARD_INGEST_API_KEY=xconectb-tenant-guard-dev-key
XCONECTB_PUBLIC_BASE_URL=https://xconectb-example.0x730.com
XCONECTB_ALLOWED_ORIGINS=https://xconectb-example.0x730.com,https://xconectb-example-host.0x730.com,https://gateway.0x730.com
XCONECTB_HOST_BOOTSTRAP_API_KEYS=xconectb-dev-api-key
XCONECTB_HOST_BOOTSTRAP_SIGNING_SECRET=dev-xconectb-host-bootstrap-secret
XCONECTB_HOST_BOOTSTRAP_SIGNING_KEY_ID=bootstrap-current
XCONECTB_HOST_BOOTSTRAP_VERIFIER_KEYS_JSON={"bootstrap-current":"dev-xconectb-host-bootstrap-secret"}
XCONECTB_HOST_SESSION_SIGNING_SECRET=dev-xconectb-host-session-secret
XCONECTB_HOST_SESSION_SIGNING_KEY_ID=session-current
XCONECTB_HOST_SESSION_VERIFIER_KEYS_JSON={"session-current":"dev-xconectb-host-session-secret"}
XCONECTB_HOST_PUBLIC_BASE_URL=https://xconectb-example-host.0x730.com
XCONECTB_HOST_BACKEND_BASE_URL=https://xconectb-example.0x730.com
XCONECTB_HOST_BOOTSTRAP_BACKEND_BASE_URL=http://xconectb:3313
XCONECTB_HOST_BOOTSTRAP_API_KEY=xconectb-dev-api-key
XCONECTB_TENANT_PAYMENT_URL=https://xconectb-example.0x730.com/tenant-payment.html
XCONECTB_TENANT_PAYMENT_RETURN_SECRET=dev-tenant-b-payment-return-secret
XCONECTB_TENANT_PAYMENT_RETURN_SECRET_REF=
XCONECTB_TENANT_PAYMENT_RETURN_URL_ALLOWLIST=https://xconectb-example.0x730.com,https://xconectb-example-host.0x730.com,https://gateway.0x730.com

XCONECTC_APP_ENV=production
XCONECTC_APP_DEBUG=false
XCONECTC_APP_KEY=base64:4aQNHs2PAAv8bEzkE0dS+DR23B8DQdnMfh4hGZhqJbQ=
XCONECTC_SESSION_DRIVER=file
XCONECTC_CACHE_STORE=file
XCONECTC_QUEUE_CONNECTION=sync
XCONECTC_PUBLIC_BASE_URL=https://xconectc-example.0x730.com
XCONECTC_HOST_PUBLIC_BASE_URL=https://xconectc-example-host.0x730.com
XCONECTC_HOST_BACKEND_BASE_URL=https://xconectc-example.0x730.com
XCONECTC_TENANT_API_KEY=xapps_test_xconectc_key_123456789
XCONECTC_GUARD_INGEST_API_KEY=xconectc-tenant-guard-dev-key
XCONECTC_PUBLISHER_API_URL=http://xplace-example:3016
XCONECTC_IDP_BASE_URL=https://xconectc-example.0x730.com/api
XCONECTC_ALLOWED_ORIGINS=https://xconectc-example.0x730.com,https://xconectc-example-host.0x730.com,https://gateway.0x730.com
XCONECTC_HOST_BOOTSTRAP_API_KEYS=xapps_test_xconectc_key_123456789
XCONECTC_HOST_BOOTSTRAP_SIGNING_SECRET=xconectc-host-bootstrap-dev-secret
XCONECTC_HOST_BOOTSTRAP_SIGNING_KEY_ID=bootstrap-current
XCONECTC_HOST_BOOTSTRAP_VERIFIER_KEYS_JSON={"bootstrap-current":"xconectc-host-bootstrap-dev-secret"}
XCONECTC_HOST_SESSION_SIGNING_SECRET=xconectc-host-session-dev-secret
XCONECTC_HOST_SESSION_SIGNING_KEY_ID=session-current
XCONECTC_HOST_SESSION_VERIFIER_KEYS_JSON={"session-current":"xconectc-host-session-dev-secret"}
XCONECTC_TENANT_PAYMENT_URL=https://xconectc-example.0x730.com/tenant-payment.html
XCONECTC_TENANT_PAYMENT_RETURN_SECRET=xconectc-dev-tenant-payment-return-secret
XCONECTC_TENANT_PAYMENT_RETURN_SECRET_REF=
XCONECTC_TENANT_PAYMENT_RETURN_URL_ALLOWLIST=https://xconectc-example.0x730.com,https://xconectc-example-host.0x730.com,https://gateway.0x730.com

XCONECTC_HOST_APP_ENV=production
XCONECTC_HOST_APP_DEBUG=false
XCONECTC_HOST_APP_KEY=base64:4aQNHs2PAAv8bEzkE0dS+DR23B8DQdnMfh4hGZhqJbQ=
XCONECTC_HOST_SESSION_DRIVER=file
XCONECTC_HOST_CACHE_STORE=file
XCONECTC_HOST_QUEUE_CONNECTION=sync
XCONECTC_HOST_BOOTSTRAP_BACKEND_BASE_URL=http://xconectc:8001
XCONECTC_HOST_BOOTSTRAP_API_KEY=xapps_test_xconectc_key_123456789
XCONECTC_HOST_PUBLISHER_API_URL=http://xplace-example:3016
XCONECTC_HOST_IDP_BASE_URL=https://xconectc-example-host.0x730.com/api

XPLACE_EXAMPLE_GATEWAY_PUBLISHER_API_KEY=xplace-example-dev-api-key
XPLACE_EXAMPLE_XAPP_INGEST_API_KEY=xplace-example-dev-api-key
XPLACE_EXAMPLE_ADMIN_KEY=xplace-example-dev-admin-key
# Required only when using xop-partners-examples-publish.sh so manifests resolve to the public xplace-example backend.
XPLACE_EXAMPLE_PUBLIC_BASE_URL=https://xplace-example.0x730.com
# Default client-scoped gateway key used by XMS-backed example tools.
XPLACE_EXAMPLE_TARGET_CLIENT_API_KEY=xconecta-dev-api-key
# Optional JSON map keyed by stable tenant/client slugs for additional example tenants.
# Example:
# XPLACE_EXAMPLE_TARGET_CLIENT_API_KEY_SLUG_MAP={"xconectb":"xconectb-dev-api-key","xconectc":"xapps_test_xconectc_key_123456789"}
XPLACE_EXAMPLE_TARGET_CLIENT_API_KEY_SLUG_MAP=
# Optional JSON map keyed by concrete target client ids for compatibility with already-seeded local ids.
# Example:
# XPLACE_EXAMPLE_TARGET_CLIENT_API_KEY_MAP={"01KN717RDJ613CSCR4008CT7H4":"xapps_test_xconectc_key_123456789"}
XPLACE_EXAMPLE_TARGET_CLIENT_API_KEY_MAP=
XPLACE_EXAMPLE_DATABASE_URL=postgresql://xapps:xapps@host.docker.internal:5432/xplace_example
XPLACE_EXAMPLE_ANAF_API_BASE_URL=https://webservicesp.anaf.ro
XPLACE_EXAMPLE_WEATHER_API_BASE_URL=https://api.open-meteo.com
XPLACE_EXAMPLE_PORTAL_BASE_URL=https://gateway.0x730.com/apps/portal
XPLACE_EXAMPLE_PUBLISHER_BASE_URL=https://gateway.0x730.com/apps/publisher
